# Copy to reproduce/litellm/.env and fill in.
OPENAI_API_KEY=sk-...                      # your OpenAI key (must have gpt-5 access)
LITELLM_MASTER_KEY=sk-litellm-master-...   # any strong secret; the runner uses it to mint budget keys
POSTGRES_PASSWORD=litellm
LITELLM_PORT=4000
# gpt-5 token prices (USD per token) for per-task $ budget accounting.
# Set to current OpenAI gpt-5 pricing. Example placeholders below.
GPT5_INPUT_COST_PER_TOKEN=0.00000125
GPT5_OUTPUT_COST_PER_TOKEN=0.00001000
